# ── Python ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Virtual environments ─────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment / secrets ────────────────────────────────────────
# Never commit a real SECRET_KEY or any credentials
.env
*.env
secrets.json

# ── Application runtime files ────────────────────────────────────
# Written by the app at runtime, not part of the source.
# The database is created (and demo accounts seeded) automatically on
# first run, so a populated heart_disease.db must never be committed or
# shipped - it may contain real assessment records.
heart_disease.db
custom_dataset.csv
system_settings.json
*.log

# ── Editors and OS ───────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
desktop.ini
.DS_Store

# ── Test / build artefacts ───────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
build/
dist/
*.egg-info/
